	(text "This mosfet allows VCC(3.3V) to power the ESP8622's 3.3V pins when\npowered from the battery. When the ESP8622 is powered from the\ndev board, ESPVIN(5V) will turn off this P-Channel Mosfet and therefore\nleave VCC disconnnected, so only the dev board will be powered."
		(exclude_from_sim no)
		(at 264.16 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
